APP_JWT_SECRET=replace-with-a-long-random-secret

# SMTP settings for email notifications
APP_MAIL_SMTP_HOST=smtp.example.com
APP_MAIL_SMTP_PORT=587
APP_MAIL_SMTP_USERNAME=mailer@example.com
APP_MAIL_SMTP_PASSWORD=replace-with-an-app-password
APP_MAIL_SMTP_STARTTLS_ENABLE=true

# Optional container runtime settings
HOST_PORT=8080
TEAM_NAME=local
